{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Alpha Chemist pharmaceutical medicine, prescription drug, OTC item, or surgical supply",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "genericName": { "type": "string" },
        "dosage": { "type": "string" },
        "categoryId": { "type": "string" },
        "categoryName": { "type": "string" },
        "unitType": { "type": "string" },
        "buyingPrice": { "type": "number" },
        "sellingPrice": { "type": "number" },
        "openingStock": { "type": "number" },
        "currentStock": { "type": "number" },
        "stockAdded": { "type": "number" },
        "barcode": { "type": "string" },
        "minStockLevel": { "type": "number" },
        "prescriptionRequired": { "type": "boolean" },
        "batchNumber": { "type": "string" },
        "expiryDate": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "name", "categoryId", "sellingPrice"]
    },
    "Category": {
      "title": "Category",
      "description": "Pharmacy medicine and healthcare product category",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "Sale": {
      "title": "Sale",
      "description": "Chemist sales transaction and dispensing record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "totalAmount": { "type": "number" },
        "paymentMethod": { "type": "string" },
        "cashierId": { "type": "string" },
        "cashierName": { "type": "string" },
        "businessDayId": { "type": "string" },
        "date": { "type": "string" }
      },
      "required": ["id", "totalAmount"]
    },
    "StockMovement": {
      "title": "StockMovement",
      "description": "Medicine inventory restock and adjustment audit trail",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "productId": { "type": "string" },
        "productName": { "type": "string" },
        "previousStock": { "type": "number" },
        "addedQty": { "type": "number" },
        "newStock": { "type": "number" },
        "date": { "type": "string" },
        "adminName": { "type": "string" },
        "reason": { "type": "string" }
      },
      "required": ["id", "productId", "addedQty", "newStock"]
    }
  },
  "firestore": {
    "/businesses/{businessId}/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Alpha Chemist medicines and supplies inventory collection"
    },
    "/businesses/{businessId}/categories/{categoryId}": {
      "schema": { "$ref": "#/entities/Category" },
      "description": "Pharmacy product categories collection"
    },
    "/businesses/{businessId}/sales/{saleId}": {
      "schema": { "$ref": "#/entities/Sale" },
      "description": "Sales and dispensing records collection"
    },
    "/businesses/{businessId}/stockMovements/{movementId}": {
      "schema": { "$ref": "#/entities/StockMovement" },
      "description": "Inventory restock and audit movements collection"
    }
  }
}
